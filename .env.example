# Copia questo file in .env per lo sviluppo locale con `vercel dev`.
# NON committare mai il file .env reale (è già in .gitignore).
DEEPSEEK_API_KEY=la-tua-chiave-deepseek

# Chiave API per Google Cloud Text-to-Speech (voce neurale). Se assente o
# non valida, l'app torna automaticamente alla sintesi vocale del browser.
GOOGLE_TTS_API_KEY=la-tua-chiave-google-tts

# Facoltativa: nome della voce it-IT da usare (default: it-IT-Neural2-A).
# GOOGLE_TTS_VOICE=it-IT-Neural2-A
