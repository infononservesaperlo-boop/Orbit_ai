# Copia questo file in .env per lo sviluppo locale con `vercel dev`.
# NON committare mai il file .env reale (è già in .gitignore).
DEEPSEEK_API_KEY=la-tua-chiave-deepseek

# Chiave e regione di Microsoft Azure Speech (voce neurale). Se assenti o
# non validi, l'app torna automaticamente alla sintesi vocale del browser.
AZURE_TTS_KEY=la-tua-chiave-azure-speech
AZURE_TTS_REGION=westeurope

# Facoltativa: nome della voce it-IT da usare (default: it-IT-IsabellaNeural).
# AZURE_TTS_VOICE=it-IT-IsabellaNeural
