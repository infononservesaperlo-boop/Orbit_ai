# Copia questo file in .env per lo sviluppo locale con `vercel dev`.
# NON committare mai il file .env reale (è già in .gitignore).
DEEPSEEK_API_KEY=la-tua-chiave-deepseek

# Nessuna variabile d'ambiente serve per la voce dell'AI: usa Piper TTS
# (voce italiana "Paola"), eseguito interamente nel browser dello studente
# via WebAssembly, senza chiavi API né account. Vedi README.md.
